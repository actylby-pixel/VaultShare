# 数据目录（默认 ff/data）
VAULTSHARE_DATA=
# Web 监听地址
VAULTSHARE_HOST=127.0.0.1
VAULTSHARE_PORT=5000
# 密钥代理监听地址（仅本地回环）
VAULTSHARE_BROKER_HOST=127.0.0.1
VAULTSHARE_BROKER_PORT=5051
# 反向代理终结 TLS 时设为 1，会话 Cookie 会加 Secure
VAULTSHARE_HTTPS=0
# 反向代理子路径（例如 Nginx location /vault/ 时填 /vault）；留空表示部署在根路径。
# 代理若发送 X-Forwarded-Prefix，也可不设这一项。
VAULTSHARE_URL_PREFIX=
# 允许在服务器网页上完成上传（需要上传发送方身份私钥文件与口令）。
# 开启后 Web 进程会短暂接触发送方私钥和明文 K_pkg，削弱“Web 永不见 K_pkg”
# 的边界；只在你完全掌控服务器时开启。默认 0。
VAULTSHARE_WEB_UPLOAD=1
# Flask 会话密钥文件；留空使用 data/secrets/flask_secret.key
VAULTSHARE_FLASK_SECRET=
# 客户端只信任该 PEM 证书/CA（自签名部署用）；设置后不再加载系统根证书。
# 命令行也可用 --ca-file 覆盖；图形界面/打包 exe 只能通过这个变量指定。
VAULTSHARE_CA_FILE=
